{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python tools/build_all.py)",
      "Bash(python3 tools/build_all.py)",
      "Bash(python tools/check.py)",
      "Bash(python3 tools/check.py)",
      "Bash(python tools/check.py --ci)",
      "Bash(python3 tools/check.py --ci)",
      "Bash(python tools/put_translation.py:*)",
      "Bash(python3 tools/put_translation.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./site/img/bild-08.webp)",
      "Read(./site/img/bild-09.webp)",
      "Read(./site/img/bild-1*.webp)",
      "Read(./site/img/bild-20.webp)",
      "Read(./site/img/bild-21.webp)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; command -v python3 >/dev/null 2>&1 || P=python; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
